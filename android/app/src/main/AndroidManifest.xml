<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".CubicalCompareApplication"
        android:allowBackup="true"
        android:icon="@drawable/icon"
        android:label="Cubical Compare 2.0.7 Native"
        android:roundIcon="@drawable/icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.CubicalCompare">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RendererManagerActivity"
            android:exported="false"
            android:label="Renderer library" />

        <activity
            android:name=".RendererImportActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Import Cubical Compare renderer"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CubicalCompare.RendererDialog">

            <!-- Preferred MIME for renderers exported by Cubical Compare. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/vnd.cubicalcompare.renderer" />
                <data android:scheme="file" android:mimeType="application/vnd.cubicalcompare.renderer" />
            </intent-filter>

            <!-- Most Android file providers expose unknown .renderer files as octet-stream. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- Allow Share -> Cubical Compare for .renderer packages. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.cubicalcompare.renderer" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".ExportService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaProcessing" />
    </application>
</manifest>
