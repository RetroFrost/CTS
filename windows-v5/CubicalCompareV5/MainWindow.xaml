<Window x:Class="CubicalCompareV5.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Cubical Compare V5" Width="1340" Height="835" MinWidth="1080" MinHeight="660"
 FontFamily="Segoe UI Variable, Segoe UI" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource WindowBrush}">
 <Window.Resources>
  <SolidColorBrush x:Key="WindowBrush" Color="#EA121822"/>
  <SolidColorBrush x:Key="PanelBrush" Color="#F21D2632"/>
  <SolidColorBrush x:Key="FieldBrush" Color="#FF293443"/>
  <SolidColorBrush x:Key="TextBrush" Color="#FFF5F7FC"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#FFAAB6C5"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#FF3CC8D6"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="13,9"/>
   <Setter Property="Margin" Value="3"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="10,9"/>
   <Setter Property="Margin" Value="0,5,0,11"/>
   <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
   <Setter Property="Foreground" Value="#18222D"/>
   <Setter Property="Padding" Value="8,6"/>
   <Setter Property="Margin" Value="3"/>
  </Style>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style TargetType="Border" x:Key="PanelStyle">
   <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
   <Setter Property="CornerRadius" Value="15"/>
   <Setter Property="Padding" Value="14"/>
   <Setter Property="Margin" Value="7"/>
  </Style>
 </Window.Resources>
 <Grid Margin="14,12,14,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="6,0,6,11">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Background="#FF3CC8D6" CornerRadius="11" Width="43" Height="43" Margin="0,0,14,0">
     <Grid><TextBlock Text="◈" Foreground="#102330" FontWeight="Bold" FontSize="31" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    </Border>
    <StackPanel><TextBlock FontSize="21" FontWeight="Bold" Text="Cubical Compare V5"/>
     <TextBlock x:Name="Subtitle" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="Comparison video studio · Windows"/></StackPanel>
   </StackPanel>
   <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
    <Button x:Name="NewButton" Click="New_Click" Content="New"/>
    <Button x:Name="OpenButton" Click="Open_Click" Content="Open"/>
    <Button x:Name="SaveButton" Click="Save_Click" Content="Save"/>
    <Button x:Name="ImportButton" Click="Import_Click" Content="Import CSV"/>
    <Button x:Name="ExportButton" Click="Export_Click" Background="#166B78" Content="Export MP4"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*" MinWidth="440"/><ColumnDefinition Width="275"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="CardsHeading" FontWeight="Bold" FontSize="16" Margin="5,4,0,12" Text="Cards"/>
      <UniformGrid Columns="4" Margin="0,0,0,9">
       <Button x:Name="AddButton" Click="Add_Click" Content="＋" ToolTip="Add card"/>
       <Button x:Name="RemoveButton" Click="Remove_Click" Content="−" ToolTip="Remove card"/>
       <Button x:Name="MoveUpButton" Click="MoveUp_Click" Content="↑" ToolTip="Move up"/>
       <Button x:Name="MoveDownButton" Click="MoveDown_Click" Content="↓" ToolTip="Move down"/>
      </UniformGrid>
     </StackPanel>
     <ListBox x:Name="CardList" SelectionChanged="CardList_SelectionChanged"
      DisplayMemberPath="Title" Foreground="{DynamicResource TextBrush}"
      Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>
   </Border>
   <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="4,1,4,14">
      <DockPanel Margin="0,0,0,8">
       <TextBlock x:Name="PreviewHeading" FontSize="16" FontWeight="Bold" Text="Canvas / Live preview" DockPanel.Dock="Left" VerticalAlignment="Center"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="DrawButton" Content="✎ Draw" Click="Draw_Click"/>
        <Button x:Name="EraseButton" Content="Eraser" Click="Erase_Click"/>
        <Button x:Name="ClearButton" Content="Clear ink" Click="Clear_Click"/>
       </StackPanel>
      </DockPanel>
      <StackPanel Orientation="Horizontal">
       <Button x:Name="MainModeButton" Background="#166B78" Content="Main image" Click="MainMode_Click"/>
       <Button x:Name="ThumbnailModeButton" Content="Thumbnail" Click="ThumbnailMode_Click"/>
       <Button x:Name="ThumbnailExportButton" Content="Export thumbnail PNG" Click="ExportThumbnail_Click"/>
      </StackPanel>
     </StackPanel>
     <Border Grid.Row="1" Background="#080C11" CornerRadius="10" Padding="8">
      <Viewbox Stretch="Uniform">
       <Grid Width="960" Height="540">
        <Grid x:Name="Stage" Width="960" Height="540" Background="#111825" ClipToBounds="True">
        <Border x:Name="CardPanel" Background="#FFF6F8FB" CornerRadius="22" Width="630" Height="514" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Grid Margin="18">
          <Grid.RowDefinitions>
           <RowDefinition Height="84"/><RowDefinition Height="63"/><RowDefinition Height="*"/><RowDefinition Height="62"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="PreviewTitle" Foreground="#101724" FontWeight="Bold" FontSize="34" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center"/>
          <Border Grid.Row="1" x:Name="BadgePanel" Background="#EC394D" CornerRadius="12" HorizontalAlignment="Center" Padding="25,5">
           <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PreviewBadgeHeader" Foreground="White" FontWeight="Bold" FontSize="23" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock x:Name="PreviewBadge" Foreground="White" FontWeight="ExtraBold" FontSize="29" VerticalAlignment="Center"/>
           </StackPanel>
          </Border>
          <Grid Grid.Row="2" ClipToBounds="True">
           <Image x:Name="ArtworkImage" Stretch="Uniform" Margin="8" RenderTransformOrigin="0.5,0.5" Cursor="SizeAll" MouseLeftButtonDown="Artwork_MouseDown" MouseMove="Artwork_MouseMove" MouseLeftButtonUp="Artwork_MouseUp" LostMouseCapture="Artwork_LostCapture"/>
           <InkCanvas x:Name="Sketch" Background="Transparent" EditingMode="None" IsHitTestVisible="False"/>
          </Grid>
          <TextBlock x:Name="PreviewDescription" Grid.Row="3" Foreground="#263544" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center"/>
         </Grid>
        </Border>
        </Grid>
        <Grid x:Name="ThumbnailStage" Width="960" Height="540" ClipToBounds="True" Visibility="Collapsed">
         <Grid.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
           <GradientStop Color="#142A45" Offset="0"/>
           <GradientStop Color="#065A70" Offset="1"/>
          </LinearGradientBrush>
         </Grid.Background>
         <Rectangle Fill="#132D49" Width="530" Height="530" HorizontalAlignment="Right" RadiusX="25" RadiusY="25" Margin="0,5,5,5"/>
         <Image x:Name="ThumbnailArtworkImage" Stretch="Uniform" Width="500" Height="470" HorizontalAlignment="Right" Margin="0,30,25,30" RenderTransformOrigin="0.5,0.5" Cursor="SizeAll" MouseLeftButtonDown="Artwork_MouseDown" MouseMove="Artwork_MouseMove" MouseLeftButtonUp="Artwork_MouseUp" LostMouseCapture="Artwork_LostCapture"/>
         <StackPanel Margin="48,75,0,0" Width="395" HorizontalAlignment="Left" VerticalAlignment="Top">
          <TextBlock Text="CUBICAL COMPARE" Foreground="#71EAF1" FontSize="19" FontWeight="Bold"/>
          <TextBlock x:Name="ThumbnailPreviewTitle" Foreground="White" FontSize="51" FontWeight="ExtraBold" TextWrapping="Wrap" Margin="0,20,0,28"/>
          <Border x:Name="ThumbnailBadgePanel" Background="#EC394D" CornerRadius="12" Padding="18,12" HorizontalAlignment="Left">
           <TextBlock x:Name="ThumbnailPreviewBadge" Foreground="White" FontWeight="Bold" FontSize="27"/>
          </Border>
         </StackPanel>
         <InkCanvas x:Name="ThumbnailSketch" Background="Transparent" EditingMode="None" IsHitTestVisible="False"/>
        </Grid>
       </Grid>
      </Viewbox>
     </Border>
     <TextBlock x:Name="PreviewHint" Grid.Row="2" Text="Canvas: 1920 × 1080 · Draw directly over artwork" Foreground="{DynamicResource MutedBrush}" Margin="6,13,3,3" FontSize="12"/>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <TextBlock x:Name="EditorHeading" FontWeight="Bold" FontSize="16" Text="Card editor" Margin="4,3,0,17"/>
      <TextBlock x:Name="TitleLabel" Text="Title"/>
      <TextBox x:Name="TitleEdit" TextChanged="EditorChanged"/>
      <TextBlock x:Name="BadgeHeaderLabel" Text="Badge header"/>
      <TextBox x:Name="BadgeHeaderEdit" TextChanged="EditorChanged"/>
      <TextBlock x:Name="BadgeValueLabel" Text="Badge value"/>
      <TextBox x:Name="BadgeEdit" TextChanged="EditorChanged"/>
      <TextBlock x:Name="BadgeUnitLabel" Text="Badge unit"/>
      <TextBox x:Name="BadgeUnitEdit" TextChanged="EditorChanged"/>
      <TextBlock x:Name="DescriptionLabel" Text="Description"/>
      <TextBox x:Name="DescriptionEdit" TextChanged="EditorChanged" TextWrapping="Wrap" AcceptsReturn="True" Height="70"/>
      <TextBlock x:Name="BadgeColorLabel" Text="Badge colour"/>
      <Button x:Name="ColorButton" Content="Choose badge colour" Click="Color_Click"/>
      <TextBlock x:Name="ArtworkLabel" Text="Artwork" Margin="0,16,0,0"/>
      <Button x:Name="ArtworkButton" Content="Import image..." Click="Artwork_Click"/>
      <Button x:Name="RemoveArtworkButton" Content="Remove image" Click="RemoveArtwork_Click"/>
      <Button x:Name="CopyMainTransformButton" Content="Copy main image transform → thumbnail" Click="CopyMainTransform_Click" Visibility="Collapsed"/>
      <Separator Margin="0,12,0,12"/>
      <TextBlock x:Name="TransformHeading" Text="Image transform" FontWeight="Bold" FontSize="16" Margin="0,0,0,5"/>
      <DockPanel><TextBlock x:Name="ScaleLabel" Text="Scale"/><TextBlock x:Name="ScaleReadout" DockPanel.Dock="Right" Text="100%" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
      <Slider x:Name="ScaleSlider" Minimum="0.1" Maximum="4" Value="1" TickFrequency="0.05" SmallChange="0.05" ValueChanged="Transform_Changed" Margin="5,4,5,10"/>
      <DockPanel><TextBlock x:Name="OffsetXLabel" Text="Position X"/><TextBlock x:Name="OffsetXReadout" DockPanel.Dock="Right" Text="0 px" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
      <Slider x:Name="OffsetXSlider" Minimum="-480" Maximum="480" ValueChanged="Transform_Changed" Margin="5,4,5,10"/>
      <DockPanel><TextBlock x:Name="OffsetYLabel" Text="Position Y"/><TextBlock x:Name="OffsetYReadout" DockPanel.Dock="Right" Text="0 px" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
      <Slider x:Name="OffsetYSlider" Minimum="-270" Maximum="270" ValueChanged="Transform_Changed" Margin="5,4,5,10"/>
      <DockPanel><TextBlock x:Name="RotationLabel" Text="Rotation"/><TextBlock x:Name="RotationReadout" DockPanel.Dock="Right" Text="0°" Foreground="{DynamicResource MutedBrush}"/></DockPanel>
      <Slider x:Name="RotationSlider" Minimum="-180" Maximum="180" ValueChanged="Transform_Changed" Margin="5,4,5,10"/>
      <CheckBox x:Name="FlipXCheck" Content="Flip horizontal" Foreground="{DynamicResource TextBrush}" Checked="TransformFlip_Changed" Unchecked="TransformFlip_Changed" Margin="5,4,5,8"/>
      <CheckBox x:Name="FlipYCheck" Content="Flip vertical" Foreground="{DynamicResource TextBrush}" Checked="TransformFlip_Changed" Unchecked="TransformFlip_Changed" Margin="5,4,5,8"/>
      <Button x:Name="ResetTransformButton" Content="Reset transform" Click="ResetTransform_Click"/>
      <TextBlock x:Name="ThumbnailTransformHint" Visibility="Collapsed" Text="Thumbnail-only transforms are saved separately and baked into the PNG. The video image stays unchanged." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="5,9,5,4"/>
      <Separator Margin="0,17,0,12"/>
      <TextBlock x:Name="PreferencesHeading" Text="Preferences" FontWeight="Bold" FontSize="16" Margin="0,0,0,7"/>
      <TextBlock x:Name="LanguageLabel" Text="Language"/>
      <ComboBox x:Name="LanguageCombo" SelectionChanged="Language_Changed"/>
      <TextBlock x:Name="ThemeLabel" Text="Appearance" Margin="0,9,0,0"/>
      <ComboBox x:Name="ThemeCombo" SelectionChanged="Theme_Changed"/>
      <TextBlock x:Name="RenderLabel" Text="Preview rendering" Margin="0,9,0,0"/>
      <CheckBox x:Name="CpuRendering" Content="Compatibility mode (software GPU fallback)" Checked="Cpu_Checked" Unchecked="Cpu_Checked"
        Foreground="{DynamicResource TextBrush}" Margin="4,8,2,4"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <DockPanel Grid.Row="2" Margin="11,12,11,0">
   <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{DynamicResource MutedBrush}" FontSize="12" DockPanel.Dock="Left"/>
   <ProgressBar x:Name="ExportProgress" Width="180" Height="7" Maximum="100" Value="0" Visibility="Collapsed" HorizontalAlignment="Right"/>
  </DockPanel>
 </Grid>
</Window>