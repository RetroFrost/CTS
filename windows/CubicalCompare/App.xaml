<Application
    x:Class="CubicalCompare.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="BrandFontFamily">Nexa</FontFamily>
            <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#141414" />
            <SolidColorBrush x:Key="EditorSurfaceRaisedBrush" Color="#1D1D1D" />
            <SolidColorBrush x:Key="EditorBorderBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="AccentYellowBrush" Color="#FFFF00" />

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
                <Setter Property="FontWeight" Value="ExtraBold" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
                <Setter Property="FontWeight" Value="ExtraBold" />
            </Style>
            <Style TargetType="NavigationViewItem">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
                <Setter Property="FontWeight" Value="ExtraBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
