<Application
    x:Class="CubicalCompare.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>

            <Style TargetType="ComboBoxItem">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,8" />
            </Style>
            <Style TargetType="MenuFlyoutPresenter">
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style TargetType="FlyoutPresenter">
                <Setter Property="CornerRadius" Value="12" />
            </Style>

            <FontFamily x:Key="BrandFontFamily">Segoe UI Variable Display</FontFamily>
            <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#F3F5FA" />
            <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#A6F3F5FA" />
            <SolidColorBrush x:Key="EditorSurfaceRaisedBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="EditorSurfaceSoftBrush" Color="#EEF0F7" />
            <SolidColorBrush x:Key="EditorBorderBrush" Color="#DCE1EC" />
            <SolidColorBrush x:Key="EditorBorderStrongBrush" Color="#C5CBDB" />
            <SolidColorBrush x:Key="EditorTextSecondaryBrush" Color="#5F667B" />
            <SolidColorBrush x:Key="EditorAccentBrush" Color="#5B4BDD" />
            <SolidColorBrush x:Key="EditorAccentSoftBrush" Color="#ECE8FF" />
            <SolidColorBrush x:Key="AccentYellowBrush" Color="#FFFF00" />

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="NumberBox">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style TargetType="NavigationViewItem">
                <Setter Property="FontFamily" Value="{StaticResource BrandFontFamily}" />
                <Setter Property="MinHeight" Value="44" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>