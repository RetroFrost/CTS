<Window
    x:Class="CubicalCompare.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid Padding="14,0,150,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{ThemeResource SystemAccentColor}" />
                    <TextBlock Text="Cubical Compare" FontFamily="{StaticResource BrandFontFamily}" FontSize="16" VerticalAlignment="Center" />
                    <Border Padding="8,3" CornerRadius="8" Background="{StaticResource EditorSurfaceRaisedBrush}">
                        <TextBlock Text="4.0 · Windows" FontSize="11" Opacity="0.72" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="ProjectNameText" Grid.Column="1" Text="Untitled comparison" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.72" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="New" Click="NewProjectWithFileState_Click" />
                    <Button Content="Open" Click="OpenProject_Click" />
                    <Button Content="Save" Click="SaveProject_Click" />
                    <Button Content="Save as" Click="SaveProjectAs_Click" />
                    <Button Content="Import Zipack2" Click="ImportMegaPack_Click" />
                    <Button x:Name="ExportVideoButton" Content="Export video" Click="ExportVideo_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            CompactPaneLength="52"
            OpenPaneLength="186"
            Loaded="RootNavigation_Loaded"
            SelectionChanged="RootNavigation_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Project" Tag="project">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Assets" Tag="assets">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Thumbnail" Tag="thumbnail">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Renderer" Tag="renderer">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="16">
                <Grid x:Name="ProjectPage">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource EditorSurfaceRaisedBrush}" BorderBrush="{StaticResource EditorBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="CARDS" FontSize="12" Opacity="0.6" Margin="4,2,0,10" />
                            <ListView x:Name="CardsList" Grid.Row="1" ItemsSource="{x:Bind Cards, Mode=OneWay}" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,6" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Value}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Grid Grid.Row="2" Margin="0,10,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Add card" HorizontalAlignment="Stretch" Click="AddCard_Click" />
                                <Button Grid.Column="1" Content="Remove" HorizontalAlignment="Stretch" Click="RemoveCard_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="Black" BorderBrush="{StaticResource EditorBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                        <Grid>
                            <Viewbox Stretch="Uniform">
                                <Border Width="960" Height="540" Background="#101010" CornerRadius="4">
                                    <Grid>
                                        <Image x:Name="RenderedFrameImage" Stretch="Uniform" Visibility="Collapsed" />
                                        <Grid x:Name="CardMockPreview" DataContext="{Binding SelectedItem, ElementName=CardsList}">
                                            <Image Source="{Binding Preview}" Stretch="UniformToFill" Opacity="0.72" />
                                            <Border VerticalAlignment="Bottom" Background="#CC111111" Padding="24,18">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="30" FontFamily="{StaticResource BrandFontFamily}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="16" Opacity="0.72" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Padding="18,8" CornerRadius="20" Background="{ThemeResource SystemAccentColor}">
                                                <TextBlock Text="{Binding Value}" FontSize="20" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource EditorSurfaceRaisedBrush}" BorderBrush="{StaticResource EditorBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel DataContext="{Binding SelectedItem, ElementName=CardsList}" Spacing="10">
                                <TextBlock Text="INSPECTOR" FontSize="12" Opacity="0.6" />
                                <TextBlock Text="Title" FontSize="12" Opacity="0.7" Margin="0,6,0,-5" />
                                <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Value" FontSize="12" Opacity="0.7" Margin="0,6,0,-5" />
                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Description" FontSize="12" Opacity="0.7" Margin="0,6,0,-5" />
                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="110" TextWrapping="Wrap" />
                                <TextBlock Text="Artwork" FontSize="12" Opacity="0.7" Margin="0,6,0,-5" />
                                <TextBlock Text="{Binding ImagePath}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" Opacity="0.55" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="Choose artwork…" HorizontalAlignment="Stretch" Click="ChooseArtwork_Click" />
                                    <Button Grid.Column="1" Content="Clear" Click="ClearArtwork_Click" />
                                </Grid>

                                <Expander Header="Transform / resize" IsExpanded="True" Margin="0,4,0,0">
                                    <StackPanel Spacing="8" Margin="0,8,0,0">
                                        <TextBlock Text="471 × 872 artwork slot · position is in pixels" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />
                                        <Grid ColumnSpacing="8" RowSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                                                <TextBlock Text="X" FontSize="11" Opacity="0.65" />
                                                <NumberBox x:Name="ImageXBox" Value="{Binding ImageX, Mode=TwoWay}" Minimum="-4000" Maximum="4000" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="ArtworkTransform_ValueChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Y" FontSize="11" Opacity="0.65" />
                                                <NumberBox x:Name="ImageYBox" Value="{Binding ImageY, Mode=TwoWay}" Minimum="-4000" Maximum="4000" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="ArtworkTransform_ValueChanged" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                                                <TextBlock Text="Scale" FontSize="11" Opacity="0.65" />
                                                <NumberBox x:Name="ImageScaleBox" Value="{Binding ImageScale, Mode=TwoWay}" Minimum="0.05" Maximum="12" SmallChange="0.05" SpinButtonPlacementMode="Compact" ValueChanged="ArtworkTransform_ValueChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Rotation" FontSize="11" Opacity="0.65" />
                                                <NumberBox x:Name="ImageRotationBox" Value="{Binding ImageRotation, Mode=TwoWay}" Minimum="-360" Maximum="360" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="ArtworkTransform_ValueChanged" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="3">
                                                <TextBlock Text="Crop left" FontSize="11" Opacity="0.65" />
                                                <NumberBox x:Name="ImageCropLeftBox" Value="{Binding ImageCropLeft, Mode=TwoWay}" Minimum="0" Maximum="0.95" SmallChange="0.01" SpinButtonPlacementMode="Compact" ValueChanged="ArtworkTransform_ValueChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Crop right" FontSize="11" Opacity="0.65" />
                                                <NumberBox x:Name="ImageCropRightBox" Value="{Binding ImageCropRight, Mode=TwoWay}" Minimum="0" Maximum="0.95" SmallChange="0.01" SpinButtonPlacementMode="Compact" ValueChanged="ArtworkTransform_ValueChanged" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="3" Grid.Column="0" Spacing="3">
                                                <TextBlock Text="Crop top" FontSize="11" Opacity="0.65" />
                                                <NumberBox x:Name="ImageCropTopBox" Value="{Binding ImageCropTop, Mode=TwoWay}" Minimum="0" Maximum="0.95" SmallChange="0.01" SpinButtonPlacementMode="Compact" ValueChanged="ArtworkTransform_ValueChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Crop bottom" FontSize="11" Opacity="0.65" />
                                                <NumberBox x:Name="ImageCropBottomBox" Value="{Binding ImageCropBottom, Mode=TwoWay}" Minimum="0" Maximum="0.95" SmallChange="0.01" SpinButtonPlacementMode="Compact" ValueChanged="ArtworkTransform_ValueChanged" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Fit" HorizontalAlignment="Stretch" Click="ArtworkTransform_Fit_Click" />
                                            <Button Grid.Column="1" Content="Fill" HorizontalAlignment="Stretch" Click="ArtworkTransform_Fill_Click" />
                                            <Button Grid.Column="2" Content="Center" HorizontalAlignment="Stretch" Click="ArtworkTransform_Center_Click" />
                                            <Button Grid.Column="3" Content="Reset" HorizontalAlignment="Stretch" Click="ArtworkTransform_Reset_Click" />
                                        </Grid>
                                        <Button Content="Apply current transform to all cards" HorizontalAlignment="Stretch" Click="ArtworkTransform_ApplyAll_Click" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0" Background="{StaticResource EditorSurfaceRaisedBrush}" BorderBrush="{StaticResource EditorBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FrameCounterText" Text="Frame —" VerticalAlignment="Center" Opacity="0.65" MinWidth="90" />
                                <Slider x:Name="ProjectFrameSlider" Grid.Column="1" Minimum="0" Maximum="0" Value="0" IsEnabled="False" StepFrequency="1" ValueChanged="ProjectFrameSlider_ValueChanged" />
                                <TextBlock x:Name="TimelineStatusText" Grid.Column="2" Text="Load a renderer to enable timeline" VerticalAlignment="Center" Opacity="0.55" />
                            </Grid>
                            <Grid Grid.Row="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ExportStatusText" Text="" VerticalAlignment="Center" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                                <ProgressBar x:Name="ExportProgressBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" VerticalAlignment="Center" />
                                <Button x:Name="ExportCancelButton" Grid.Column="2" Content="Cancel export" Click="CancelVideoExport_Click" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="AssetsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="MegaPack Zipack2" FontSize="28" />
                            <TextBlock x:Name="DetectedSummaryText" Text="Import a .zipack2 package to detect contact-sheet cards." Opacity="0.62" Margin="0,4,0,0" />
                            <TextBlock x:Name="MegaPackExportStatusText" Text="Export keeps full-resolution card artwork in yellow-separated contact sheets." Opacity="0.5" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Import Zipack2" Click="ImportMegaPack_Click" />
                            <Button Content="Export MegaPack" Click="ExportMegaPack_Click" />
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="DetectedCardsList" Grid.Row="1" Margin="0,16,0,0" ItemsSource="{x:Bind DetectedCards, Mode=OneWay}" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="110" Height="72" Background="Black" CornerRadius="8">
                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Label}" FontSize="16" />
                                        <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.55" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Included, Mode=TwoWay}" Content="Include" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Grid.Row="2" Margin="0,14,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Move earlier" Click="MoveDetectedEarlier_Click" />
                        <Button Grid.Column="1" Content="Move later" Click="MoveDetectedLater_Click" />
                        <Button Grid.Column="3" Content="Use detected cards" Click="ApproveDetectedCards_Click" />
                    </Grid>
                </Grid>

                <Grid x:Name="ThumbnailPage" Visibility="Collapsed" MaxWidth="1100" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Automatic thumbnail" FontSize="28" />
                        <TextBlock Text="Cubical Compare picks three representative cards and continuously rebuilds a 1280×720 comparison thumbnail." TextWrapping="Wrap" Opacity="0.62" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Margin="0,18,0,0" Background="Black" BorderBrush="{StaticResource EditorBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                        <Viewbox Stretch="Uniform">
                            <Border Width="1280" Height="720" Background="#101010">
                                <Image x:Name="ThumbnailPreviewImage" Stretch="Uniform" />
                            </Border>
                        </Viewbox>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,14,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Regenerate" Click="RegenerateThumbnail_Click" />
                        <Button Grid.Column="1" Content="Save PNG" Click="SaveThumbnail_Click" />
                        <TextBlock x:Name="ThumbnailStatusText" Grid.Column="2" Text="Waiting for project data…" VerticalAlignment="Center" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>

                <Grid x:Name="RendererPage" Visibility="Collapsed" MaxWidth="920" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Renderer" FontSize="28" />
                        <TextBlock Text="Renderer v2 and v3 use the preserved compatibility evaluator. Renderer v4 is the native Cubical Compare 4 path." TextWrapping="Wrap" Opacity="0.62" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Row="1" Content="Load renderer package" Click="InspectRenderer_Click" HorizontalAlignment="Left" Margin="0,18,0,0" />
                    <Border Grid.Row="2" Margin="0,18,0,0" Background="{StaticResource EditorSurfaceRaisedBrush}" BorderBrush="{StaticResource EditorBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="RendererNameText" Text="No renderer selected" FontSize="20" />
                                <TextBlock x:Name="RendererGenerationText" Text="Generation —" Opacity="0.7" />
                                <TextBlock x:Name="RendererEngineText" Text="Engine —" Opacity="0.7" />
                                <TextBlock x:Name="RendererCanvasText" Text="Reference —" Opacity="0.7" />
                                <TextBlock x:Name="RendererSourceText" Text="" TextWrapping="Wrap" Opacity="0.45" />
                                <TextBlock x:Name="RendererCompatibilityText" Text="" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="Black" CornerRadius="10" MinWidth="420" MinHeight="236">
                                <Image x:Name="RendererPagePreviewImage" Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>